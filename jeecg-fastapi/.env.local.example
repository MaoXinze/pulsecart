# Copy this file to .env.local. It is ignored by Git and must stay local.
# URL-encode reserved password characters, for example @ as %40.
DATABASE_URL=mysql+pymysql://root:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:3306/jeecg-boot?charset=utf8mb4

# Use a long, local-only random value. Do not reuse the example value from .env.
SIGNATURE_SECRET=replace-with-a-long-local-random-secret

# PulseCart local development is loopback-only by default.
BIND_HOST=127.0.0.1
DEV_RELOAD=false
FRONTEND_URL=http://127.0.0.1:3100
THIRD_LOGIN_BASE_URL=http://127.0.0.1:8006/jeecg-boot
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# Enable only after deciding to require the image CAPTCHA in local development.
ENABLE_LOGIN_CAPTCHA=false

# Keep mock prediction enabled until the separate local NLP service is started.
SENTIMENT_AI_BASE_URL=http://127.0.0.1:8100
SENTIMENT_AI_MOCK=true
